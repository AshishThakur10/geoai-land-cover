# GeoAI Land Cover - local configuration
# Copy this file to .env and adjust values. Never commit .env.

# Logging
GEOAI_LOG_LEVEL=INFO
GEOAI_LOG_FILE=logs/geoai.log

# Data directories (relative paths resolve from the project root)
GEOAI_DATA_DIR=data
GEOAI_RAW_DIR=data/raw
GEOAI_PROCESSED_DIR=data/processed
GEOAI_MODELS_DIR=data/models
GEOAI_OUTPUTS_DIR=data/outputs
GEOAI_SENTINEL2_DIR=data/raw/sentinel2
GEOAI_WORLDCOVER_DIR=data/raw/worldcover
GEOAI_AOI_DIR=data/raw/aoi

# Area of interest (empty means: provide an AOI at runtime / in a later phase)
GEOAI_DEFAULT_AOI=

# Random Forest defaults
GEOAI_RANDOM_SEED=42
GEOAI_N_ESTIMATORS=150
GEOAI_MAX_DEPTH=
GEOAI_CLASS_WEIGHT=balanced_subsample

# Imagery / processing
GEOAI_TARGET_RESOLUTION=10
GEOAI_MAX_UPLOAD_MB=200
